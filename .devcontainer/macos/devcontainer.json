{
    "name": "px4_roscon_25_macos",
    "image": "dronecode/roscon-25-workshop:latest",
    "forwardPorts": [8765],
    "runArgs": [
        "--publish", "18570:18570/udp"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools",
                "ms-python.python",
                "ms-python.pylint",
                "ms-python.black-formatter",
                "ms-iot.vscode-ros",
                "smilerobotics.urdf",
                "zachflower.uncrustify",
                "redhat.vscode-yaml",
                "ms-vscode.live-share",
                "gruntfuggly.todo-tree",
                "cschlosser.doxdocgen"
            ]
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/roscon-25-workshop_ws/src/roscon-25-workshop,type=bind",
    "workspaceFolder": "/home/ubuntu/roscon-25-workshop_ws"
}
